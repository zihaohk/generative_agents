# Copy this file to .env and fill in your local secrets.

# LLM runtime
LLM_ACTIVE_STACK=siliconflow
LLM_SHADOW_STACK=none
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_AUDIT_LOG_DIR=logs/llm_audit

# SiliconFlow
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_PRIMARY_MODEL=deepseek-ai/DeepSeek-V3.2
SILICONFLOW_STRUCTURED_MODEL=Qwen/Qwen2.5-72B-Instruct
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# Optional legacy / shadow
OPENAI_API_KEY=
OPENAI_BASE_URL=
LEGACY_PRIMARY_MODEL=gpt-4.1-mini
LEGACY_STRUCTURED_MODEL=gpt-4.1-mini
LEGACY_EMBEDDING_MODEL=text-embedding-3-small
